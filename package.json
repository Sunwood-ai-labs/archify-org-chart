{
  "name": "archify-org-chart",
  "version": "1.0.0",
  "description": "Multi-organization project governance & avatar lineage tree generator powered by tt-a1i/archify",
  "type": "module",
  "bin": {
    "archify-org-chart": "./bin/archify-org-chart.mjs"
  },
  "scripts": {
    "build": "node bin/archify-org-chart.mjs build examples/ai-retail-dx.org.json project-governance-with-avatars.html",
    "build:starter": "node bin/archify-org-chart.mjs build templates/starter.org.json starter-governance.html",
    "docs:dev": "npm --prefix docs run docs:dev",
    "docs:build": "npm --prefix docs run docs:build",
    "docs:preview": "npm --prefix docs run docs:preview"
  },
  "keywords": [
    "archify",
    "org-chart",
    "project-governance",
    "architecture-diagram",
    "svg",
    "japanese-project-management"
  ],
  "license": "MIT"
}
